def scopes_intersect(a: list, b: list) -> bool:
    """True when two declared scopes could touch the same files.

    An empty scope is undeclared, not empty — it could be anything, so it
    intersects everything. Prefix comparison over-reports rather than missing a
    real collision.
    """
    if not a or not b:
        return True
    return any(x.startswith(y) or y.startswith(x) for x in a for y in b)


# --------------------------------------------------------------------------
# Commands
# --------------------------------------------------------------------------
def cmd_fleet(args) -> int:
    repos = toimija_repos(load_roots(args.root))
    scans = scan_fleet(repos)

    if args.json:
        print(json.dumps({
            "repos": [
                {
                    "repo": str(s.repo), "coverage": s.coverage, "error": s.error,
                    "warnings": s.warnings,
                    "sessions": [
                        {"id": x.id, "agent": x.agent, "worktree": str(x.worktree),
                         "branch": x.branch, "intent": x.intent, "scope": x.scope,
                         "liveness": x.liveness, "idle_seconds": x.idle_seconds}
                        for x in s.sessions if x.liveness == "active"
                    ],
                } for s in scans
            ],
        }, indent=2))
    else:
        any_live = False
        for s in sorted(scans, key=lambda s: s.repo.name):
            live = [x for x in s.sessions if x.liveness == "active"]
            if not live and not s.error:
                continue
            any_live = any_live or bool(live)
            print(f"{s.repo.name}")
            if s.error:
                print(f"    ! scan failed: {s.error}")
            for x in live:
                print(f"    {x.agent}  {x.id}")
                print(f"      branch: {x.branch or 'detached'}   seen: {ago(x.idle_seconds)}"
                      + ("   IDLE" if x.idle_seconds > STALE_AFTER else ""))
                print(f"      intent: {x.intent or '(undeclared)'}")
                if x.scope:
                    print(f"      scope:  {', '.join(x.scope)}")
            for w in s.warnings:
                print(f"    warning: {w}")
        if not any_live:
            print("no live sessions")

    failed = [s for s in scans if s.coverage == "failed"]
    sys.stdout.flush()  # stdout is block-buffered when piped; keep the report in order
    print(f"\ncoverage: scanned {len(scans) - len(failed)}/{len(scans)} repo(s)", file=sys.stderr)
    if failed:
        # joskus-contract rule: an empty result under failed coverage is not
        # evidence that nothing exists. Say so rather than implying quiet.
        print("  incomplete — absence here is not evidence of absence:", file=sys.stderr)
        for s in failed:
            print(f"    {s.repo.name}: {s.error}", file=sys.stderr)
        return INCOMPLETE
    return 0


def cmd_why(args) -> int:
    repos = toimija_repos(load_roots(args.root))
    cmd = ["sauma", "why", args.query]
    for r in repos:
        cmd += ["--root", str(r)]
    if args.json:
        cmd.append("--json")
    print(f"ohjaa: walking {len(repos)} repo(s)", file=sys.stderr)
    return subprocess.run(cmd).returncode


def cmd_run(args) -> int:
    root = Path(git(["rev-parse", "--show-toplevel"]).strip())
    req = Request(args.agent, args.intent, args.scope, root)

    scan = scan_repo(root)
    if scan.coverage == "failed":
        print(f"ohjaa: cannot read sessions in {root}: {scan.error}", file=sys.stderr)
        print("ohjaa: refusing to seat blind", file=sys.stderr)
        return REFUSED

    seat = choose_seat(req, [s for s in scan.sessions if s.liveness == "active"])
    if seat.worktree is None:
        print(f"ohjaa: refused — {seat.reason}", file=sys.stderr)
        return REFUSED

    print(f"ohjaa: {seat.reason}", file=sys.stderr)
    if args.dry_run:
        return 0

    if not seat.worktree.exists():
        git(["worktree", "add", "-b", f"agent/{seat.worktree.name}",
             str(seat.worktree), args.base], cwd=root)

    cmd = ["toimija", "run", "--intent", req.intent]
    for path in req.scope:
        cmd += ["--scope", path]
    cmd += ["--", req.agent]
    os.chdir(seat.worktree)
    return subprocess.run(cmd).returncode


def main() -> int:
    ap = argparse.ArgumentParser(prog="ohjaa", description=__doc__.split("\n")[0])
    ap.add_argument("--root", action="append", default=[],
                    help="repeatable; defaults to the config file, else this repo's siblings")
    sub = ap.add_subparsers(dest="cmd", required=True)

    f = sub.add_parser("fleet", help="who is live, across every repo")
    f.add_argument("--json", action="store_true")
    f.set_defaults(fn=cmd_fleet)

    w = sub.add_parser("why", help="provenance walk across every repo")
    w.add_argument("query", help="digest, token, or artifact id")
    w.add_argument("--json", action="store_true")
    w.set_defaults(fn=cmd_why)

    r = sub.add_parser("run", help="seat an agent safely, then hand off to toimija run")
    r.add_argument("agent")
    r.add_argument("--intent", required=True)
    r.add_argument("--scope", action="append", default=[])
    r.add_argument("--base", default="origin/main")
    r.add_argument("--dry-run", action="store_true")
    r.set_defaults(fn=cmd_run)

    args = ap.parse_args()
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
