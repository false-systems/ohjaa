#!/usr/bin/env python3
"""ohjaa — the deciding layer above toimija.

Toimija reports facts and refuses to decide (`.toimija/repo.yaml`: no dispatch,
no assignment, no network). That refusal is deliberate, so the deciding lives
out here. ohjaa does three things and stores nothing:

    ohjaa fleet                    who is live, across every repo
    ohjaa why <digest|token>       provenance walk across every repo
    ohjaa run <agent> --intent ..  seat an agent safely, then hand off

Everything is derived on demand. There is no inbox, no index, and no cache:
a scan reflects now, whereas a delivered message is stale the moment the
sender's world moves. Cross-repo facts travel as digests anchored to a
repository point, so they self-invalidate exactly like a gate receipt does
when the tree moves.

Exit codes: 0 ok · 3 refused · 4 scan coverage incomplete.
"""

from __future__ import annotations

import argparse
import concurrent.futures
import json
import os
import subprocess
import sys
import time
from dataclasses import dataclass, field
from pathlib import Path

REFUSED = 3
INCOMPLETE = 4

CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "ohjaa" / "roots"
STALE_AFTER = 90 * 60  # matches toimija's own inactivity rule (proposal 0002)


# --------------------------------------------------------------------------
# Types
# --------------------------------------------------------------------------
@dataclass
class Session:
    """One session, as toimija reports it. `liveness` is toimija's call, not ours."""

    id: str
    agent: str
    worktree: Path
    branch: str | None
    intent: str
    scope: list = field(default_factory=list)
    liveness: str = "unknown"
    last_seen_at: int = 0

    @property
    def idle_seconds(self) -> int:
        return max(0, int(time.time()) - self.last_seen_at) if self.last_seen_at else -1


@dataclass
class Scan:
    """One repo's scan result. `error` is not an empty result — see coverage."""

    repo: Path
    sessions: list = field(default_factory=list)
    warnings: list = field(default_factory=list)
    coverage: str = "available"
    error: str | None = None


@dataclass
class Request:
    agent: str
    intent: str
    scope: list
    worktree: Path


@dataclass
class Seat:
    """The decision. `worktree` is where the agent runs; None means refuse."""

    worktree: Path | None
    reason: str


# --------------------------------------------------------------------------
# Roots — derived by default, configured only if you insist
# --------------------------------------------------------------------------
def default_roots() -> list:
    """The sibling directories of this repo.

    Zero-config and honest: if you work in ~/projects/toimija, the fleet is
    ~/projects/*. Storing a root list is the first step toward storing a fleet
    index, so we avoid it until you actually override.
    """
    try:
        here = Path(git(["rev-parse", "--show-toplevel"]).strip())
    except subprocess.CalledProcessError:
        return [Path.cwd()]
    return [here.parent]


def load_roots(explicit: list) -> list:
    if explicit:
        return [Path(r).expanduser() for r in explicit]
    if CONFIG.is_file():
        roots = []
        for line in CONFIG.read_text().splitlines():
            line = line.split("#", 1)[0].strip()
            if line:
                roots.append(Path(line).expanduser())
        if roots:
            return roots
    return default_roots()


def toimija_repos(roots: list) -> list:
    """Every toimija-prepared repo under the roots. A root may itself be one."""
    found, seen = [], set()
    for root in roots:
        candidates = [root] + sorted(p for p in root.glob("*") if p.is_dir())
        for path in candidates:
            if (path / ".toimija").is_dir() and path not in seen:
                seen.add(path)
                found.append(path)
    return found


# --------------------------------------------------------------------------
# Scanning
# --------------------------------------------------------------------------
def git(args: list, cwd: Path | None = None) -> str:
    return subprocess.run(
        ["git"] + args, cwd=cwd, check=True, capture_output=True, text=True
    ).stdout


def scan_repo(repo: Path) -> Scan:
    """Ask one repo's toimija who is live. Never raises: a failure is a fact."""
    try:
        out = subprocess.run(
            ["toimija", "sessions", "--json"],
            cwd=repo, capture_output=True, text=True, timeout=20,
        )
        if out.returncode != 0:
            return Scan(repo, coverage="failed", error=(out.stderr.strip().splitlines() or ["exit %d" % out.returncode])[-1])
        payload = json.loads(out.stdout)
    except Exception as exc:  # timeout, bad json, missing binary
        return Scan(repo, coverage="failed", error=f"{type(exc).__name__}: {exc}")

    sessions = [
        Session(
            id=s["id"],
            agent=(s.get("agent") or ["unknown"])[0],
            worktree=Path(s["worktree"]),
            branch=s.get("branch"),
            intent=s.get("intent") or "",
            scope=s.get("scope") or [],
            liveness=s.get("liveness", "unknown"),
            last_seen_at=s.get("last_seen_at") or 0,
        )
        for s in payload.get("sessions", [])
    ]
    return Scan(
        repo,
        sessions=sessions,
        warnings=payload.get("warnings") or [],
        coverage=(payload.get("coverage") or {}).get("status", "available"),
    )


def scan_fleet(repos: list) -> list:
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        return list(pool.map(scan_repo, repos))


def ago(seconds: int) -> str:
    if seconds < 0:
        return "never"
    if seconds < 90:
        return f"{seconds}s ago"
    if seconds < 5400:
        return f"{seconds // 60}m ago"
    return f"{seconds // 3600}h ago"


