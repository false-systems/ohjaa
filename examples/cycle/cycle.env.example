# Copy to $CYCLE_DIR/cycle.env (or point CYCLE_ENV at it) and source it.
# Paths only; nothing here is state.
export CYCLE_DIR=/tmp/cycle-1                    # outside the repository tree
export KELPO=$HOME/projects/kelpo/kelpo.py
export KELPO_ASSEMBLE=$HOME/projects/kelpo/examples/assemble_verdict.py
export KISKO_SEED=$HOME/.cargo-target/debug/examples/seed_store   # cargo build --example seed_store in kisko
export CYCLE_SIGNER=operator                      # identity in the Kisko trust root; the cycle allows it to launch
export CYCLE_RIGOR=standard                       # smoke | standard; standard demands red evidence
export CYCLE_QA_CONTRACT=tests/qa/sykli.json      # the QA graph Sykli runs; committed before the work begins
export CYCLE_SUITE_ROOT=tests/qa
# obligation -> QA tasks; every obligation needs one, every task belongs to one
export CYCLE_CASES='{"obl_note":["validate-json-valid","validate-json-invalid"],"obl_gate-sykli-full":["locked-graph-validates"],"obl_scope":["last-commit-changes-only-src"],"obl_repository-changed":["last-commit-changes-only-src"]}'
