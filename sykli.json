        ".github/workflows/ci.yml",
        ".gitignore",
        ".toimija/repo.yaml",
        "AGENTS.md",
        "CLAUDE.md",
        "Cargo.lock",
        "Cargo.toml",
        "LICENSE",
        "README.md",
        "docs/assets/ohjaa.svg",
        "docs/reference.md",
        "rust-toolchain.toml",
        "scripts/vendor-faija-knowledge.sh",
        "src/apply.rs",
        "src/collect.rs",
        "src/doctor.rs",
        "src/evidence.rs",
        "src/flat_toml.rs",
        "src/gitconfig.rs",
        "src/home.rs",
        "src/human.rs",
        "src/instructions.rs",
        "src/intake.rs",
        "src/knowledge.rs",
        "src/lessons.rs",
        "src/lessons/spelling.rs",
        "src/main.rs",
        "src/process.rs",
        "src/repo_docs.rs",
        "src/roots.rs",
        "src/scan.rs",
        "src/shell_init.rs",
